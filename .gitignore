# Backend
backend/facimate/src/main/resources/application.properties
backend/facimate/src/main/resources/application-dev.properties
backend/facimate/src/main/resources/application-local.properties

### Build Artifacts ###
# Backend
target/
build/
.gradle/
*.class
*.jar

# Frontend
node_modules/
dist/
dist-ssr/
.next/
out/

### Logs ###
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

### OS Files ###
.DS_Store
Thumbs.db
*.swp
*.swo
*~

